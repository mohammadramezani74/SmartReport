@page "/scan"
@using System.Text
@using System.Text.Json
@using SmartReportLog.Model.Atm.Submit
@using SmartReportLog.Services.atm.Command.SaveData
@inject IAtmIngestionService IngestionService
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [AllowAnonymous]
<PageTitle>ثبت گزارش دستگاه</PageTitle>

<div class="scan-container" dir="rtl">
    @switch (_state)
    {
        case ScanState.Loading:
            <div class="status-box loading">
                <div class="spinner"></div>
                <p>در حال پردازش و ثبت اطلاعات...</p>
            </div>
            break;

        case ScanState.Success:
            <div class="status-box success">
                <span class="icon">✅</span>
                <p>اطلاعات با موفقیت ذخیره شد</p>
                <small>@_message</small>
            </div>
            break;

        case ScanState.Error:
            <div class="status-box error">
                <span class="icon">❌</span>
                <p>خطا در ثبت اطلاعات</p>
                <small>@_message</small>
            </div>
            break;
    }
</div>

<style>
    .scan-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        font-family: Tahoma, sans-serif;
        padding: 16px;
    }

    .status-box {
        text-align: center;
        padding: 32px 24px;
        border-radius: 16px;
        max-width: 360px;
        width: 100%;
    }

    .status-box.loading { background: #f0f2f5; color: #333; }
    .status-box.success { background: #e6f4ea; color: #1e7e34; }
    .status-box.error { background: #fdecea; color: #a94442; }

    .status-box p { font-size: 18px; margin: 8px 0; font-weight: bold; }
    .status-box small { font-size: 13px; color: inherit; opacity: 0.85; word-break: break-word; }
    .icon { font-size: 40px; }

    .spinner {
        width: 40px; height: 40px;
        border: 4px solid #ccc;
        border-top-color: #555;
        border-radius: 50%;
        margin: 0 auto 12px;
        animation: spin 0.8s linear infinite;
    }

    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
</style>

@code {
    [SupplyParameterFromQuery(Name = "d")]
    public string? EncodedData { get; set; }

    private enum ScanState { Loading, Success, Error }
    private ScanState _state = ScanState.Loading;
    private string _message = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(EncodedData))
            {
                SetError("داده‌ای در لینک یافت نشد.");
                return;
            }

            var days = DecodeQrPayload(EncodedData);

            var result = await IngestionService.IngestAsync(days, CancellationToken.None);

            if (result.Success)
            {
                _state = ScanState.Success;
                _message = result.Message;
            }
            else
            {
                SetError(result.Message);
            }
        }
        catch (Exception ex)
        {
            SetError("خطای پردازش: " + ex.Message);
        }
    }

    private void SetError(string message)
    {
        _state = ScanState.Error;
        _message = message;
    }

    private static AtmScanDayDto DecodeQrPayload(string encoded)
    {
        // معکوس کردن Base64Url
        string b64 = encoded.Replace('-', '+').Replace('_', '/');
        switch (b64.Length % 4)
        {
            case 2: b64 += "=="; break;
            case 3: b64 += "="; break;
        }

        var jsonBytes = Convert.FromBase64String(b64);
        var json = Encoding.UTF8.GetString(jsonBytes);

        var days = JsonSerializer.Deserialize<AtmScanDayDto>(json,
            new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

        if (days == null )
            throw new InvalidOperationException("ساختار داده نامعتبر است.");

        return days;
    }
}